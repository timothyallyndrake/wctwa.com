---
import "../styles/global.css";
import { announcement, nav, site } from "../content/site";
import { withBase } from "../lib/with-base";

interface Props {
  title: string;
  description?: string;
  home?: boolean;
  showHeader?: boolean;
  showFooter?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = site.tagline,
  home = false,
  showHeader = true,
  showFooter = true,
  bodyClass = "",
} = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.shortName}`;

const now = Date.now();
const startsOk =
  !announcement.startsAt || now >= Date.parse(announcement.startsAt);
const endsOk = !announcement.endsAt || now <= Date.parse(announcement.endsAt);
const showAnnouncement = announcement.active && announcement.message && startsOk && endsOk;

const trialHref = withBase("/start/?intent=trial");
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
    <link rel="icon" href={withBase("/favicon.ico")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Barlow+Semi+Condensed:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[{ "layout--home": home }, bodyClass]}>
    <!--
      Pinned world: bright civic school, white ground, navy fields, bright-blue links,
      red only for the trial action, Barlow Semi Condensed display, Atkinson body,
      documentary photos in grid frames, trial action in the header (bottom bar on narrow).
      User-pinned 2026-10-14. No concept seed.
    -->
    <svg class="site-clips" aria-hidden="true" focusable="false" width="0" height="0">
      <defs>
        <clipPath id="site-clip-wave-bottom" clipPathUnits="objectBoundingBox">
          <path d="M0,0 H1 V0.8 C0.75,0.96 0.25,0.7 0,0.84 L0,0 Z"></path>
        </clipPath>
        <clipPath id="site-clip-footer-top" clipPathUnits="objectBoundingBox">
          <path d="M0,0.72 C0.25,0.28 0.75,0.48 1,0.22 V1 H0 Z"></path>
        </clipPath>
      </defs>
    </svg>
    {
      showAnnouncement && (
        <div class="banner" role="status">{announcement.message}</div>
      )
    }
    {
      showHeader && (
        <header class="site-header">
          <div class="site-header__inner wrap">
            <a class="brand-lockup" href={withBase("/")}>
              <img src={withBase(site.marks.school.src)} alt="" width="40" height="40" />
              <span>{site.shortName}</span>
            </a>
            <button
              class="site-header__menu-button"
              type="button"
              aria-expanded="false"
              aria-controls="primary-navigation"
            >
              <span class="visually-hidden">Menu</span>
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
            </button>
            <nav id="primary-navigation" aria-label="Primary">
              <ul class="nav">
                {nav.map((item) => (
                  <li>
                    <a href={withBase(item.href)}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </header>
      )
    }

    <main class:list={[{ "main--home": home }]}>
      <slot />
    </main>

    {
      showHeader && (
        <div class="trial-bottom-bar" aria-hidden="false">
          <a class="button button--signal trial-bottom-bar__link" href={trialHref}>
            Try 2 weeks
          </a>
        </div>
      )
    }

    <script>
      const siteHeader = document.querySelector(".site-header");
      const menuButton = siteHeader?.querySelector<HTMLButtonElement>(".site-header__menu-button");

      menuButton?.addEventListener("click", () => {
        const isOpen = siteHeader?.toggleAttribute("data-menu-open");
        menuButton.setAttribute("aria-expanded", String(Boolean(isOpen)));
      });

      siteHeader?.querySelectorAll("nav a").forEach((link) => {
        link.addEventListener("click", () => {
          siteHeader?.removeAttribute("data-menu-open");
          menuButton?.setAttribute("aria-expanded", "false");
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          siteHeader?.removeAttribute("data-menu-open");
          menuButton?.setAttribute("aria-expanded", "false");
          menuButton?.focus();
        }
      });
    </script>

    {
      showFooter && (
        <footer class="site-footer">
          <div class="wrap site-footer__inner">
            <div class="site-footer__col site-footer__col--identity">
              <strong class="site-footer__name">{site.name}</strong>
              <div class="affiliation-mark">
                <img
                  src={withBase(site.marks.foundation.src)}
                  alt={site.marks.foundation.alt}
                  width="68"
                  height="68"
                />
                <p>Affiliated with the United States Taekwondo Education Foundation</p>
              </div>
            </div>
            <div class="site-footer__col site-footer__col--contact">
              <p class="site-footer__line">
                <a href={site.address.mapsUrl}>
                  {site.address.line1}, {site.address.city}, {site.address.state}{" "}
                  {site.address.zip}
                </a>
              </p>
              <p class="site-footer__line">
                <a href={site.phone.href}>{site.phone.display}</a>
              </p>
              <p class="site-footer__line">
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </p>
            </div>
            <div class="site-footer__col site-footer__col--legal">
              <p class="site-footer__line">
                <a href={withBase("/members/")}>Member sign in</a>
                <span class="site-footer__note"> — family portal coming soon</span>
              </p>
              <p class="site-footer__legal">
                <a href={withBase("/privacy-policy/")}>Privacy Policy</a>
                {" · "}
                © {year} {site.name}
              </p>
            </div>
          </div>
        </footer>
      )
    }
  </body>
</html>
