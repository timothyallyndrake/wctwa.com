---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageTitle from "../../components/PageTitle.astro";
import { withBase } from "../../lib/with-base";

const credentials = [
  "7th Degree World Tae Kwon Do Federation Black Belt",
  "4th Degree Yong Moo Do",
  "Yong-In University graduate, major in Tae Kwon Do",
  "Course of Teaching Profession in Education",
  "National Champion 1995",
  "20 years experience",
  "Taekwondo of America Master — founded by Olympic Gold Medalist Master Kim Je-Kyoung (1992)",
  "USAT Certified Coach",
];
---

<BaseLayout
  title="Master Chulan Kim"
  description="Credentials and background for Master Chulan Kim, headmaster of World Champion Taekwondo Washougal."
>
  <PageTitle title="Master Chulan Kim" />
  <section class="page">
    <div class="wrap">
      <div class="instructor-profile">
        <figure class="instructor-profile__photo">
          <img
            src={withBase("/images/source/instructors-main.webp")}
            alt="Master Chulan Kim"
            width="771"
            height="1000"
            loading="lazy"
          />
        </figure>
        <div class="instructor-profile__content">
          <p class="type-body">Headmaster of World Champion Taekwondo Washougal.</p>
          <ul class="instructor-profile__credentials">
            {credentials.map((item) => <li>{item}</li>)}
          </ul>
          <a class="text-link" href={withBase("/instructors/")}>Instructors</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
