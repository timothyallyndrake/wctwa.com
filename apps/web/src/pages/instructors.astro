---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTitle from "../components/PageTitle.astro";
import { site } from "../content/site";
import { withBase } from "../lib/with-base";
---

<BaseLayout
  title="Instructors"
  description="Meet Master Chulan Kim, headmaster of World Champion Taekwondo Washougal."
>
  <PageTitle title="Instructors" />
  <section class="page">
    <div class="wrap page-story__copy">
      <section>
        <h2 class="type-heading">Master Chulan Kim</h2>
        <p class="type-body">
          Headmaster of World Champion Taekwondo Washougal. His credentials are listed on his own page.
        </p>
        <a class="text-link" href={withBase("/instructors/master-chulan-kim/")}>View credentials</a>
      </section>

      <div class="affiliation-mark">
        <img
          src={withBase(site.marks.foundation.src)}
          alt={site.marks.foundation.alt}
          width="72"
          height="72"
          loading="lazy"
        />
        <p>Affiliated with the United States Taekwondo Education Foundation.</p>
      </div>

      <a class="button button--signal" href={withBase("/start/info/")}>Request information</a>
    </div>
  </section>
</BaseLayout>
