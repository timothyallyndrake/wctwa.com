---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content/site";
import { withBase } from "../lib/with-base";
---

<BaseLayout
  title="Instructors"
  description="Meet Master Chulan Kim, headmaster of World Champion Taekwondo Washougal."
>
  <section class="page">
    <div class="wrap">
      <h1>Instructors</h1>
      <h2>Master Chulan Kim</h2>
      <p>
        Headmaster of World Champion Taekwondo Washougal.
        <a class="text-link" href={withBase("/instructors/master-chulan-kim/")}>View credentials</a>
      </p>
      <div class="affiliation-mark" style="margin:1.75rem 0;">
        <img src={withBase(site.marks.foundation.src)} alt={site.marks.foundation.alt} width="72" height="72" />
        <p>
          United States Taekwondo Education Foundation — affiliation mark
          shown with Master Kim’s credentials.
        </p>
      </div>
      <p><a class="cta" href={withBase("/start/?intent=info")}>Request information</a></p>
    </div>
  </section>
</BaseLayout>
