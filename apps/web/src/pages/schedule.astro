---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/with-base";
---

<BaseLayout
  title="Schedule"
  description="Class schedule and hours for World Champion Taekwondo Washougal."
>
  <section class="page">
    <div class="wrap">
      <h1>Schedule</h1>
      <p class="muted">Effective Feb 23, 2026 — structured data coming next.</p>

      <h2>Hours</h2>
      <ul>
        <li>Monday – Friday: 2pm – 8pm</li>
        <li>Saturday: Events only</li>
        <li>Sunday: Closed</li>
      </ul>

      <h2>Weekly classes</h2>
      <p class="muted">
        Full grid will be modeled in content (not a fragile HTML table dump).
        Level 1 &amp; 2 students need safety gear. Sparring requires full gear.
      </p>
      <p><a class="cta" href={withBase("/start/")}>Reserve your first class</a></p>
    </div>
  </section>
</BaseLayout>
