---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTitle from "../components/PageTitle.astro";
import {
  officeHours,
  scheduleEffective,
  weeklyCaption,
  weeklyRows,
  weekdayLabels,
  weekdays,
  type Weekday,
} from "../content/schedule";
import { withBase } from "../lib/with-base";
---

<BaseLayout
  title="Schedule"
  description="Class schedule and hours for World Champion Taekwondo Washougal."
>
  <PageTitle title="Schedule" />
  <section class="page">
    <div class="wrap schedule-page">
      <div class="page-story__copy">
        <p class="type-body">Effective {scheduleEffective}.</p>

        <section>
          <h2 class="type-heading">Hours</h2>
          <ul class="page-story__list">
            {officeHours.map((line) => <li>{line}</li>)}
          </ul>
        </section>
      </div>

      <div class="schedule-table-wrap">
        <table class="schedule-table">
          <caption>{weeklyCaption}</caption>
          <thead>
            <tr>
              <th scope="col">Time</th>
              {
                weekdays.map((day) => (
                  <th scope="col">{weekdayLabels[day]}</th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              weeklyRows.map((row) => (
                <tr>
                  <th scope="row">{row.time}</th>
                  {
                    weekdays.map((day: Weekday) => {
                      const value = row[day];
                      return (
                        <td>
                          {value ? (
                            value
                          ) : (
                            <>
                              —<span class="visually-hidden">No class</span>
                            </>
                          )}
                        </td>
                      );
                    })
                  }
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="page-story__copy">
        <section>
          <h2 class="type-heading">Who the classes are for</h2>
          <ul class="page-story__list">
            <li>Tiny Tiger: ages 3–5</li>
            <li>Beginner: white through high orange and high blue</li>
            <li>Level 1: orange, blue, and high red</li>
            <li>Level 2: yellow, green, brown, and black</li>
            <li>Level 3: high green and red</li>
          </ul>
        </section>

        <section>
          <h2 class="type-heading">Gear</h2>
          <ul class="page-story__list">
            <li>Level 1 and Level 2 students need safety gear.</li>
            <li>Sparring class requires full sparring gear.</li>
          </ul>
        </section>

        <a class="button button--signal" href={withBase("/start/")}>
          Reserve your first class
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
