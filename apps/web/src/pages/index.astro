---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content/site";
import { withBase } from "../lib/with-base";

const programs = [
  {
    href: withBase("/programs/tiny-tigers-martial-arts/"),
    title: "Tiny Tigers",
    blurb: "Energetic classes for children under 6 — respect, kindness, and fun on the mat.",
    image: withBase("/images/source/home-tiny-tigers-martial-arts.jpg"),
    alt: "Tiny Tigers class at World Champion Taekwondo Washougal.",
  },
  {
    href: withBase("/programs/kids-martial-arts/"),
    title: "Kids",
    blurb: "Confidence, discipline, and leadership — at each child’s pace.",
    image: withBase("/images/source/home-kids-martial-arts.jpg"),
    alt: "Kids martial arts class in Washougal.",
  },
  {
    href: withBase("/programs/adults-and-families-martial-arts/"),
    title: "Adults & Families",
    blurb: "Fitness, self-defense, and classes families can train in together.",
    image: withBase("/images/source/home-adult-and-family-martial-arts.jpg"),
    alt: "Adults and families training together.",
  },
];

const trustMarkers = [
  "3307 Evergreen Way #605, Washougal, WA 98671",
  "Classes Monday–Friday, 2–8pm",
  "Saturday: events only",
  "Sunday: closed",
];

const credentials = [
  "7th Degree World Tae Kwon Do Federation Black Belt",
  "4th Degree Yong Moo Do",
  "Yong-In University",
  "National Champion 1995",
  "USAT Certified Coach",
  "Taekwondo of America Master",
];
---

<BaseLayout title={site.name} description={site.tagline} home>
  <svg class="home-clips" aria-hidden="true" focusable="false" width="0" height="0">
    <defs>
      <clipPath id="home-clip-photo-left" clipPathUnits="objectBoundingBox">
        <path d="M0.18,0 C0.06,0.32 0.06,0.68 0.18,1 H1 V0 Z"></path>
      </clipPath>
      <clipPath id="home-clip-markers-band" clipPathUnits="objectBoundingBox">
        <path d="M0,0 H1 V0.82 C0.75,0.96 0.25,0.72 0,0.86 L0,0 Z"></path>
      </clipPath>
    </defs>
  </svg>

  <section class="home-welcome" aria-label="Welcome">
    <div class="home-welcome__inner">
      <div class="home-welcome__content">
        <h1 class="type-display">Washougal trains here.</h1>
        <p class="type-body">Master Chulan Kim. A safe, positive school for families.</p>
      </div>
      <figure class="home-welcome__photo">
        <img
          src={withBase("/images/source/home-hero.webp")}
          alt="Three students in ready stance on the mat at World Champion Taekwondo Washougal."
          width="1536"
          height="1024"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="home-markers" aria-label="Location and hours">
    <div class="home-markers__band">
      <div class="wrap home-markers__panel">
        <ul class="home-markers__list">
          {trustMarkers.map((fact) => <li>{fact}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="home-master trust-section" aria-labelledby="master-heading">
    <div class="wrap home-master__inner">
      <figure class="home-master__photo">
        <img
          src={withBase("/images/source/instructors-main.webp")}
          alt="Master Chulan Kim"
          width="771"
          height="1000"
          loading="lazy"
        />
      </figure>
      <div class="home-master__content">
        <h2 id="master-heading" class="type-heading">Master Chulan Kim</h2>
        <ul class="home-master__credentials">
          {credentials.map((item) => <li>{item}</li>)}
        </ul>
        <a class="text-link" href={withBase("/instructors/")}>View full credentials</a>
      </div>
    </div>
  </section>

  <section class="home-programs" aria-labelledby="programs-heading">
    <div class="wrap">
      <h2 id="programs-heading" class="type-heading">Programs for every age</h2>
      <div class="program-grid">
        {
          programs.map((program) => (
            <article class="program home-programs__card">
              <img
                class="program__photo"
                src={program.image}
                alt={program.alt}
                width="640"
                height="427"
                loading="lazy"
              />
              <h3 class="type-heading program__title">{program.title}</h3>
              <p class="type-body muted">{program.blurb}</p>
              <a class="text-link" href={program.href}>View program</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-schedule-prompt detail-section" aria-labelledby="schedule-prompt-heading">
    <div class="wrap">
      <h2 id="schedule-prompt-heading" class="type-heading">Class times</h2>
      <p class="type-body">
        Weekday classes run from 4:00 to 7:40pm. Saturday is for events. Sunday is closed.
      </p>
      <a class="text-link" href={withBase("/schedule/")}>See the full schedule →</a>
    </div>
  </section>

  <section class="home-offer" aria-labelledby="offer-heading">
    <div class="wrap home-offer__inner">
      <div class="home-offer__copy">
        <h2 id="offer-heading" class="type-heading">Try 2 weeks for $40</h2>
        <p class="type-body">Two weeks of class — a simple way to start.</p>
      </div>
      <a class="button button--signal" href={withBase("/start/?intent=trial")}>
        Reserve your first class
      </a>
    </div>
  </section>
</BaseLayout>
