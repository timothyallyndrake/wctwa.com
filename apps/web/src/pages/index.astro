---
import BaseLayout from "../layouts/BaseLayout.astro";
import { comingSoon, site } from "../content/site";
import { withBase } from "../lib/with-base";

const programs = [
  {
    href: withBase("/programs/tiny-tigers-martial-arts/"),
    rank: "White belt",
    title: "Tiny Tigers",
    blurb: "Energetic classes for children under 6 — respect, kindness, and fun on the mat.",
    image: withBase("/images/source/home-tiny-tigers-martial-arts.jpg"),
    alt: "Tiny Tigers class at World Champion Taekwondo Washougal.",
  },
  {
    href: withBase("/programs/kids-martial-arts/"),
    rank: "Color belt",
    title: "Kids",
    blurb: "Confidence, discipline, and leadership — at each child’s pace.",
    image: withBase("/images/source/home-kids-martial-arts.jpg"),
    alt: "Kids martial arts class in Washougal.",
  },
  {
    href: withBase("/programs/adults-and-families-martial-arts/"),
    rank: "Black belt path",
    title: "Adults & Families",
    blurb: "Fitness, self-defense, and classes families can train in together.",
    image: withBase("/images/source/home-adult-and-family-martial-arts.jpg"),
    alt: "Adults and families training together.",
  },
];
---

<BaseLayout title={site.name} description={site.tagline} home>
  <section class="home-hero" aria-label="Welcome">
    <img
      class="home-hero__photo"
      src={withBase(site.hero.src)}
      alt={site.hero.alt}
      width="1920"
      height="1080"
      fetchpriority="high"
    />
    <div class="home-hero__scrim" aria-hidden="true"></div>
    <div class="home-hero__content">
      <h1 class="home-hero__headline">Washougal trains here.</h1>
      <p class="home-hero__support">
        Master Chulan Kim. A safe, positive school for families.
      </p>
      <div class="home-hero__actions">
        <a class="cta-rank" href={withBase("/start/?intent=trial")}>Reserve your first class</a>
        <a class="cta-rank cta-rank--ghost" href={withBase("/instructors/")}>Meet Master Kim</a>
      </div>
    </div>
  </section>

  <section class="home-trust weave-ground" aria-labelledby="trust-heading">
    <div class="wrap home-trust__inner">
      <img
        class="home-trust__photo"
        src={withBase("/images/source/instructors-main.webp")}
        alt="Master Chulan Kim"
        width="88"
        height="88"
        loading="lazy"
      />
      <div>
        <h2 class="home-trust__title" id="trust-heading">Master Chulan Kim</h2>
        <ul class="home-trust__facts">
          <li>7th Degree WTF Black Belt</li>
          <li>Yong-In University</li>
          <li>National Champion 1995</li>
          <li>USAT Certified Coach</li>
        </ul>
        <a class="home-trust__link" href={withBase("/instructors/")}>Full credentials</a>
      </div>
    </div>
  </section>

  <section class="home-programs weave-ground" aria-labelledby="programs-heading">
    <div class="wrap">
      <div class="home-programs__intro">
        <h2 id="programs-heading">Programs for every age</h2>
        <p class="muted">
          Tiny Tigers, Kids, and Adults &amp; Families — one school, clear paths.
        </p>
      </div>
      <ol class="program-belt-list">
        {
          programs.map((program) => (
            <li class="program-belt-row">
              <img
                class="program-belt-row__thumb"
                src={program.image}
                alt={program.alt}
                width="112"
                height="84"
                loading="lazy"
              />
              <div>
                <span class="program-belt-row__rank">{program.rank}</span>
                <h3>{program.title}</h3>
                <p>{program.blurb}</p>
              </div>
              <a class="program-belt-row__link" href={program.href}>
                Learn more
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="home-portal" aria-labelledby="portal-heading">
    <div class="wrap">
      <h2 id="portal-heading">Coming soon — a member home for every family</h2>
      <p class="home-portal__lead">{comingSoon.lead}</p>
      <ul class="home-portal__list">
        {
          comingSoon.features.map((feature) => (
            <li class="home-portal__item">
              <h3>{feature.title}</h3>
              <p>{feature.detail}</p>
            </li>
          ))
        }
      </ul>
      <div class="home-portal__actions">
        <a class="cta-rank" href={withBase(comingSoon.membersPath)}>Preview member sign in</a>
        <a class="cta-rank cta-rank--ghost" href={withBase("/start/?intent=info")}>
          Ask about membership
        </a>
      </div>
    </div>
  </section>

  <section class="home-offer weave-ground" aria-labelledby="offer-heading">
    <div class="wrap">
      <div class="home-offer__panel">
        <h2 id="offer-heading">
          {site.offer.label} — {site.offer.price}
        </h2>
        <p class="muted">{site.offer.detail}</p>
        <a class="cta-rank" href={withBase("/start/?intent=trial")}>Get started</a>
      </div>
    </div>
  </section>
</BaseLayout>
