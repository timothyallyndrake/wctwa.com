---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content/site";
---

<BaseLayout title={site.name} description={site.tagline}>
  <section class="hero">
    <div class="wrap">
      <p class="muted" style="margin:0 0 0.5rem;">Washougal, Washington</p>
      <h1 style="font-size:clamp(2.75rem, 8vw, 4.5rem);margin:0 0 1rem;">
        {site.name}
      </h1>
      <p style="max-width:36rem;font-size:1.15rem;margin:0;">
        {site.tagline} Train with Master Chulan Kim in a safe, encouraging school
        built for kids, teens, adults, and families.
      </p>
      <p style="display:flex;flex-wrap:wrap;gap:0.75rem;margin:1.5rem 0 0;">
        <a class="cta" href="/start/">Reserve your first class</a>
        <a class="cta cta-secondary" href="/instructors/">Meet Master Kim</a>
      </p>
    </div>
  </section>

  <section class="page" style="background:var(--color-white);">
    <div class="wrap">
      <h2>Programs for every age</h2>
      <p class="muted">Tiny Tigers, Kids, and Adults & Families — clarity first, then you choose.</p>
      <p><a href="/programs/">Explore programs</a></p>
    </div>
  </section>

  <section class="page">
    <div class="wrap">
      <h2>{site.offer.label} — {site.offer.price}</h2>
      <p class="muted">{site.offer.detail}</p>
      <p><a class="cta" href="/start/?intent=trial">Get started</a></p>
    </div>
  </section>
</BaseLayout>
