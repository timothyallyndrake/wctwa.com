---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTitle from "../components/PageTitle.astro";
import { withBase } from "../lib/with-base";
---

<BaseLayout
  title="Taekwondo Birthday Parties"
  description="Host a Taekwondo birthday party at World Champion Taekwondo Washougal."
>
  <PageTitle title="Birthday Parties" />
  <section class="page">
    <div class="wrap">
      <div class="page-story__copy">
        <section>
          <h2 class="type-heading">A party at the school</h2>
          <p class="type-body">
            Ninety minutes at World Champion Taekwondo Washougal. Guests practice, play games, and break a
            board.
          </p>
        </section>
        <section>
          <h2 class="type-heading">What is included</h2>
          <ul class="page-story__list">
            <li>90 minutes</li>
            <li>Practice, games, and board breaking</li>
            <li>A VIP gift pass for guests</li>
            <li>Room for 15 to 20 guests</li>
            <li>$200</li>
          </ul>
        </section>
        <a class="button button--signal" href={withBase("/start/birthday/")}>Reserve a party</a>
      </div>
    </div>
  </section>
</BaseLayout>
