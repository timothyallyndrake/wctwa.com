---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Taekwondo Birthday Parties"
  description="Host a Taekwondo birthday party at World Champion Taekwondo Washougal."
>
  <section class="page">
    <div class="wrap">
      <h1>Birthday Parties</h1>
      <p class="muted">Washougal location — Gresham copy will not return.</p>
      <ul>
        <li>Duration: 90 minutes</li>
        <li>Activities: practice, games, board breaking</li>
        <li>VIP gift passes for guests</li>
        <li>Capacity: 15–20 guests</li>
        <li>Price: $200</li>
      </ul>
      <p>
        <a class="cta" href="/start/?intent=birthday">Reserve a party</a>
      </p>
    </div>
  </section>
</BaseLayout>
