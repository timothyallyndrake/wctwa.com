---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTitle from "../components/PageTitle.astro";
import { withBase } from "../lib/with-base";
---

<BaseLayout
  title="About Us"
  description="What Taekwondo means at World Champion Taekwondo Washougal — fitness, life skills, and a positive school for families."
>
  <PageTitle title="About the school" />
  <section class="page">
    <div class="wrap">
      <article class="page-story">
        <div class="page-story__lead">
          <figure class="page-story__photo">
            <img
              src={withBase("/images/enhanced/home-kids-martial-arts.webp")}
              alt="Students practicing in class at World Champion Taekwondo Washougal."
              width="1536"
              height="952"
              loading="lazy"
            />
          </figure>
          <section>
            <h2 class="type-heading">What is Taekwondo?</h2>
            <p class="type-body">
              Taekwondo is a traditional Korean martial art — the way of the foot and hand. At World
              Champion Taekwondo Washougal, students train the body and the person together: strength,
              focus, and the habits that carry past the mat.
            </p>
          </section>
        </div>
        <div class="page-story__copy">
          <section>
            <h2 class="type-heading">Fitness and life skills</h2>
            <p class="type-body">
              Class builds fitness, balance, and control. It also builds the quieter skills families ask
              for: listening, patience, and the confidence to try again.
            </p>
          </section>
          <section>
            <h2 class="type-heading">A positive place to train</h2>
            <p class="type-body">
              The school is built around discipline, encouragement, and a room where students can grow
              without giving up. Families in Washougal train here because the teaching stays calm and the
              standard stays clear.
            </p>
          </section>
          <a class="button button--signal" href={withBase("/start/?intent=info")}>Request information</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
