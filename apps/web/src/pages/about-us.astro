---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTitle from "../components/PageTitle.astro";
import { withBase } from "../lib/with-base";
---

<BaseLayout
  title="About Us"
  description="What Taekwondo means at World Champion Taekwondo Washougal — a family school for kids and adults, and a steady place to train."
>
  <PageTitle title="About the school" />
  <section class="page">
    <div class="wrap">
      <article class="page-story">
        <div class="page-story__lead page-story__lead--copy-first">
          <section>
            <h2 class="type-heading">What is Taekwondo?</h2>
            <p class="type-body">
              Taekwondo is a traditional Korean martial art — the way of the foot and hand. At World
              Champion Taekwondo Washougal, you train the body and the person together. The strength and
              focus you practice here are meant to stay with you after class.
            </p>
            <p class="type-body">
              Students come in for different reasons. Some want to compete. Some want to get stronger, or
              feel more capable in an ordinary day. Some want people to train with. Kids classes and adult
              classes are both part of this school. What they share is confidence, discipline, and steady
              work for mind, body, and spirit.
            </p>
          </section>
          <figure class="page-story__photo">
            <img
              src={withBase("/images/enhanced/home-kids-martial-arts.webp")}
              alt="Students practicing in class at World Champion Taekwondo Washougal."
              width="1536"
              height="952"
              loading="lazy"
            />
          </figure>
        </div>
        <div class="page-story__copy">
          <section>
            <h2 class="type-heading">A family room</h2>
            <p class="type-body">
              The instructors are here in Washougal. They keep class stable and familiar, a family room
              where you can work toward your own goal and find people who will practice beside you. The
              teaching stays encouraging, the standard stays clear, and there is room to enjoy the work.
            </p>
          </section>
          <a class="button button--signal" href={withBase("/start/info/")}>Request information</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
