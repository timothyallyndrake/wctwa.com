---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="page">
    <div class="wrap">
      <h1>Page not found</h1>
      <p class="muted">That page doesn’t exist. Try the home page or Start here.</p>
      <p>
        <a class="cta" href="/">Home</a>
        <a class="cta cta-secondary" href="/start/" style="margin-left:0.5rem;">Start here</a>
      </p>
    </div>
  </section>
</BaseLayout>
