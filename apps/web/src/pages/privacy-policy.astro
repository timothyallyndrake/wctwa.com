---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTitle from "../components/PageTitle.astro";
import { site } from "../content/site";
---

<BaseLayout
  title="Privacy Policy"
  description="Privacy policy for World Champion Taekwondo Washougal."
>
  <PageTitle title="Privacy Policy" />
  <section class="page">
    <div class="wrap">
      <div class="page-story__copy">
        <section>
          <h2 class="type-heading">Information we collect</h2>
          <p class="type-body">
            When you contact the school or submit a form, we may collect your name, email, phone number,
            and message. The site may also receive standard technical data, such as IP address and browser
            type.
          </p>
        </section>
        <section>
          <h2 class="type-heading">How we use it</h2>
          <p class="type-body">
            We use this information to answer you, operate the website, and deliver what you asked for.
          </p>
        </section>
        <section>
          <h2 class="type-heading">Messages</h2>
          <p class="type-body">
            We may send a welcome email and occasional updates. We do not sell or rent customer lists.
          </p>
        </section>
        <section>
          <h2 class="type-heading">Contact</h2>
          <p class="type-body">
            Questions: <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
