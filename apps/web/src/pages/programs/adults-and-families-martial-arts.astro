---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageTitle from "../../components/PageTitle.astro";
import { withBase } from "../../lib/with-base";
---

<BaseLayout
  title="Adults and Families Martial Arts"
  description="Adult and family martial arts classes in Washougal."
>
  <PageTitle title="Adults & Families" />
  <section class="page">
    <div class="wrap">
      <article class="page-story">
        <div class="page-story__lead">
          <figure class="page-story__photo">
            <img
              src={withBase("/images/enhanced/home-adult-and-family-martial-arts.webp")}
              alt="Adults and families training together."
              width="2560"
              height="1431"
              loading="eager"
            />
          </figure>
          <section>
            <h2 class="type-heading">Train together</h2>
            <p class="type-body">
              Adult and family classes are for fitness, self-defense, and time on the mat together.
            </p>
          </section>
        </div>
        <div class="page-story__copy">
          <section>
            <h2 class="type-heading">From beginner onward</h2>
            <p class="type-body">
              You can start as a beginner and keep training. Family class is for parents and children on
              the same mat. The work is steadier than a gym routine, and it asks for patience as well as
              strength.
            </p>
          </section>
          <a class="button button--signal" href={withBase("/start/")}>Reserve a class</a>
          <a class="text-link" href={withBase("/schedule/")}>See the schedule</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
