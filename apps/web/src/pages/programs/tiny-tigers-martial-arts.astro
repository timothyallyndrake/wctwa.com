---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageTitle from "../../components/PageTitle.astro";
import { withBase } from "../../lib/with-base";
---

<BaseLayout
  title="Tiny Tigers Martial Arts"
  description="Tiny Tigers martial arts in Washougal for children under 6."
>
  <PageTitle title="Tiny Tigers" />
  <section class="page">
    <div class="wrap">
      <article class="page-story">
        <div class="page-story__lead">
          <figure class="page-story__photo">
            <img
              src={withBase("/images/enhanced/home-tiny-tigers-martial-arts.webp")}
              alt="Tiny Tigers class at World Champion Taekwondo Washougal."
              width="2048"
              height="1263"
              loading="eager"
            />
          </figure>
          <section>
            <h2 class="type-heading">For children under 6</h2>
            <p class="type-body">
              Tiny Tigers is for children under 6. Class is energetic and kind, and short enough to hold
              their attention.
            </p>
          </section>
        </div>
        <div class="page-story__copy">
          <section>
            <h2 class="type-heading">What they practice</h2>
            <p class="type-body">
              Students practice respect, manners, and listening while they move. Motor skills,
              friendships, and the habit of trying again start here.
            </p>
          </section>
          <a class="button button--signal" href={withBase("/start/")}>Reserve a class</a>
          <a class="text-link" href={withBase("/schedule/")}>See the schedule</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
