---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageTitle from "../../components/PageTitle.astro";
import { withBase } from "../../lib/with-base";
---

<BaseLayout
  title="Kids Martial Arts"
  description="Kids martial arts in Washougal — confidence, discipline, and self-control."
>
  <PageTitle title="Kids Martial Arts" />
  <section class="page">
    <div class="wrap">
      <article class="page-story">
        <div class="page-story__lead">
          <figure class="page-story__photo">
            <img
              src={withBase("/images/enhanced/home-kids-martial-arts.webp")}
              alt="Kids martial arts class in Washougal."
              width="1536"
              height="952"
              loading="eager"
            />
          </figure>
          <section>
            <h2 class="type-heading">At each child’s pace</h2>
            <p class="type-body">
              Kids classes build confidence, discipline, and self-control. Students learn at their own
              pace in a clean, supportive room.
            </p>
          </section>
        </div>
        <div class="page-story__copy">
          <section>
            <h2 class="type-heading">How class feels</h2>
            <p class="type-body">
              Instructors stay with students as they learn. Children of different ages and fitness levels
              train in a family atmosphere.
            </p>
          </section>
          <section>
            <h2 class="type-heading">What families notice</h2>
            <ul class="page-story__list">
              <li>Confidence on and off the mat</li>
              <li>Focus and listening</li>
              <li>A class community</li>
              <li>Strength and coordination</li>
            </ul>
          </section>
          <a class="button button--signal" href={withBase("/start/")}>Reserve a class</a>
          <a class="text-link" href={withBase("/schedule/")}>See the schedule</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
